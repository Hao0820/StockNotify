# Supabase 設定 (必填)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-or-anon-key

# FinMind API Token (選填，註冊免費帳號可將請求上限提升至 600次/小時)
FINMIND_API_TOKEN=

# Discord Webhook 通知設定 (選填)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email (SMTP) 通知設定 (選填，例如使用 Gmail 應用程式密碼)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL_TO=recipient1@example.com,recipient2@example.com

# 篩選參數預設值 (可透過環境變數微調)
MIN_AVG_VOLUME_SHARES=500000
KD_NEAR_CROSS_DIFF=4.0
RSI_NEAR_CROSS_DIFF=3.5
TOP_RECOMMENDATIONS_LIMIT=25
